# Copia este archivo como .env (no se versiona)
POSTGRES_PASSWORD=plataforma

# Uso local fuera de Docker
PLATAFORMA_DATABASE_URL=postgresql+psycopg://plataforma:plataforma@localhost:5432/plataforma
PLATAFORMA_SOURCES_DIR=sources

# Secretos que referencian los YAML con ${...}
SOCRATA_APP_TOKEN=

# Claves de la API, separadas por coma (una por grupo: docentes, estudiantes...).
# Vacío = API abierta, solo para desarrollo local. Genera una clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PLATAFORMA_API_KEYS=
# Orígenes web que pueden llamar la API desde un navegador (p. ej. un tablero), separados por coma
PLATAFORMA_CORS_ORIGINS=

# Servidor MCP: usuario de solo lectura creado con `plataforma crear-lector <usuario>`
PLATAFORMA_MCP_DATABASE_URL=

# Modelos de lenguaje (reservadas para el asistente del frontend; el código actual no las usa)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
